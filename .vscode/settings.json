{
  "deno.enable": true,  // ← Add this
  
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },

  "deno.enablePaths": [
    "supabase/functions"
  ],

  "deno.lint": true,

  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],

  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },

  // Add these:
  "[typescript][deno]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "deno.codelensMeta": true,
  "deno.config": "./deno.json"
}