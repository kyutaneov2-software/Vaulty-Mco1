{
  "expo": {
    "name": "Vaulty",
    "slug": "rental-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/srv-logo.png",
    "scheme": "rentalvault",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09070D",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vaulty uses your location to show nearby vaults on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09070D",
        "foregroundImage": "./assets/images/srv-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.kyutaofficial.rentalvault",
      "config": {
        "googleMaps": {
          "apiKey": "AIza...YOUR-ACTUAL-KEY-HERE"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09070D",
          "image": "./assets/images/srv-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#09070D",
            "image": "./assets/images/srv-logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vaulty to access your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vaulty uses your location to show nearby vaults on the map."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
